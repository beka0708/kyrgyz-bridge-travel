# Copy to .env and adjust. Never commit .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://kgtours:kgtours@localhost:5434/kgtours

# Email: console in dev; in prod e.g. smtp+tls://user:pass@smtp-relay.brevo.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Kyrgyz Tours <noreply@example.com>
INQUIRY_NOTIFY_EMAIL=

# Cloudflare Turnstile (empty = check disabled)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SITE_URL=http://localhost:8000
