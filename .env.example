# Copy to .env and adjust. Never commit .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://kgtours:kgtours@localhost:5434/kgtours

# Email: console in dev; in prod e.g. smtp+tls://user:pass@smtp-relay.brevo.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Kyrgyz Tours <noreply@example.com>
INQUIRY_NOTIFY_EMAIL=

# Cloudflare Turnstile (empty = check disabled)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SITE_URL=http://localhost:8000

# Maps (defaults: OpenFreeMap + OpenTopoMap + AWS terrain; override to switch provider)
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# MAP_TOPO_TILES=https://a.tile.opentopomap.org/{z}/{x}/{y}.png,https://b.tile.opentopomap.org/{z}/{x}/{y}.png
# MAP_TERRAIN_TILES=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# OpenRouteService key (free, account.heigit.org) for road/hiking route lines in the admin
ORS_API_KEY=

# Frontend: true while running `npm run dev` in frontend/ (hot reload)
VITE_DEV_MODE=false
