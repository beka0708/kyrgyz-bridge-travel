# SITE_ACCESS=preview: the whole site asks for a login and password, and search engines are told
# to stay away. For showing the site to the client before launch. /healthz/ stays open for checks.
@locked not path /healthz/
basic_auth @locked {
	{$PREVIEW_USER:preview} {$PREVIEW_PASSWORD_HASH}
}
header X-Robots-Tag "noindex, nofollow"
